<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The name of a test project says the kind of its tests, and the trait Category lets dotnet test pick one kind:
       *.UnitTests need nothing outside the process, *.IntegrationTests start PostgreSQL in Testcontainers (Docker).
       Libraries of shared test types end with TestFixtures (docs/development.md, "Tests"). -->
  <PropertyGroup>
    <TestCategory Condition="$(MSBuildProjectName.EndsWith('.UnitTests'))">Unit</TestCategory>
    <TestCategory Condition="$(MSBuildProjectName.EndsWith('.IntegrationTests'))">Integration</TestCategory>
  </PropertyGroup>

  <ItemGroup Condition="'$(TestCategory)' != ''">
    <AssemblyAttribute Include="Xunit.TraitAttribute">
      <_Parameter1>Category</_Parameter1>
      <_Parameter2>$(TestCategory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="CheckTestProjectName" BeforeTargets="Build"
          Condition="'$(TestCategory)' == '' and !$(MSBuildProjectName.EndsWith('TestFixtures'))">
    <Error Text="Test project $(MSBuildProjectName): name it *.UnitTests, *.IntegrationTests or *TestFixtures." />
  </Target>
</Project>
